// School Management System — Prisma schema.
//
// Current milestone: Fees + Payments + Receipts foundation (Phase 7A — fee
// structures, session invoices and installments; Phase 7B adds payments and
// receipts).
//
//   School, AcademicSession, User, Role, Permission, UserRole, RolePermission,
//   Session(auth tokens), Student, Teacher, Staff, Class, Section, Subject,
//   PeriodSlot, TimetableEntry, AttendanceRecord, Homework, Assignment,
//   HomeworkSubmission, AssignmentSubmission, Exam, ExamSubject, ExamResult,
//   ExamMark, FeeStructure, FeeStructureItem, FeeInvoice, FeeInstallment.
//
// Decisions:
//   - `User` is a pure authentication identity (email + password hash). Domain
//     profiles (student/teacher/parent) link to it via dedicated domain tables.
//   - Auth uses opaque bearer tokens stored as cryptographic hashes in
//     `Session` (see server/src/auth), so sessions are revocable server-side.
//   - Authorization is flat Role -> Permission (resource:action codes).
//     SUPER_ADMIN grants everything by role, never by email.
//   - TimetableEntry uses two @@unique constraints for conflict prevention
//     (class-slot and teacher-slot). AttendanceRecord snapshots classId/sectionId
//     from enrollment at mark-time for historical correctness.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  PARENT
  GUARDIAN
  LEGAL_GUARDIAN
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

// A user's access to a specific school (tenant). Isolated from the global
// User identity so the same person can belong to one or many schools.
enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum TimetableDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HOLIDAY
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TaskSubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  FINAL
  ARCHIVED
}

model School {
  id                          String       @id @default(uuid())
  name                        String
  code                        String?      @unique
  status                      SchoolStatus @default(ACTIVE)
  // Server-side admission number sequence for this school (see Student).
  admissionCounter            Int          @default(1)
  // Server-side employee ID sequences (see Teacher, Staff).
  teacherCounter              Int          @default(1)
  staffCounter                Int          @default(1)
  // Server-side sequence for admission applications (see AdmissionApplication).
  admissionApplicationCounter Int          @default(1)
  // Server-side receipt number sequence (see FeeReceipt).
  feeReceiptCounter           Int          @default(1)
  // Server-side invoice number sequence (see FeeInvoice).
  feeInvoiceCounter           Int          @default(1)
  // Server-side payment number sequence (see FeePayment).
  feePaymentCounter           Int          @default(1)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  users                 User[]
  memberships           TenantMembership[]
  academicSessions      AcademicSession[]
  classes               Class[]
  subjects              Subject[]
  students              Student[]
  guardians             Guardian[]
  teachers              Teacher[]
  staff                 Staff[]
  periodSlots           PeriodSlot[]
  feeHeads              FeeHead[]
  feeStructures         FeeStructure[]
  feeInvoices          FeeInvoice[]
  feeInstallments      FeeInstallment[]
  feePayments          FeePayment[]
  feeReceipts          FeeReceipt[]
  examTypes             ExamType[]
  gradingBands          GradingBand[]
  schoolSettings        SchoolSetting[]
  notices               Notice[]
  events                Event[]
  admissionApplications AdmissionApplication[]
  timetableEntries     TimetableEntry[]
  attendanceRecords    AttendanceRecord[]
  homeworks            Homework[]
  assignments          Assignment[]
  homeworkSubmissions  HomeworkSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  exams                Exam[]
  examResults          ExamResult[]
  examMarks            ExamMark[]
}

model AcademicSession {
  id        String                @id @default(uuid())
  schoolId  String
  name      String
  code      String
  startDate DateTime              @db.Date
  endDate   DateTime              @db.Date
  status    AcademicSessionStatus @default(UPCOMING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments           StudentEnrollment[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]
  admissionApplications AdmissionApplication[] @relation("ApplicationPreferredSession")
  timetableEntries      TimetableEntry[]
  attendanceRecords     AttendanceRecord[]
  homeworks             Homework[]
  assignments           Assignment[]
  exams                 Exam[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
}

model User {
  id           String     @id @default(uuid())
  // Tenancy: a User is a platform-global identity. schoolId is retained as a
  // convenience/legacy link to a single default school; real tenant access is
  // granted through TenantMembership (one or many schools per user).
  schoolId     String?
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school      School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  memberships TenantMembership[]
  roles       UserRole[]
  sessions    Session[]

  createdStudents Student[] @relation("StudentCreatedBy")
  updatedStudents Student[] @relation("StudentUpdatedBy")

  teacherProfile  Teacher?  @relation("TeacherUser")
  staffProfile    Staff?    @relation("StaffUser")
  studentProfile  Student?  @relation("StudentUser")
  guardianProfile Guardian? @relation("GuardianUser")

  createdNotices Notice[] @relation("NoticeCreatedBy")
  updatedNotices Notice[] @relation("NoticeUpdatedBy")
  createdEvents  Event[]  @relation("EventCreatedBy")
  updatedEvents  Event[]  @relation("EventUpdatedBy")
  createdFeeInvoices FeeInvoice[] @relation("FeeInvoiceCreatedBy")
  recordedPayments FeePayment[] @relation("PaymentRecordedBy")
  issuedReceipts   FeeReceipt[] @relation("ReceiptIssuedBy")

  createdApplications   AdmissionApplication[] @relation("ApplicationCreatedBy")
  updatedApplications   AdmissionApplication[] @relation("ApplicationUpdatedBy")
  reviewedApplications  AdmissionApplication[] @relation("ApplicationReviewedBy")
  convertedApplications AdmissionApplication[] @relation("ApplicationConvertedBy")

  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")

  createdHomework  Homework[] @relation("HomeworkCreatedBy")
  updatedHomework  Homework[] @relation("HomeworkUpdatedBy")
  createdAssignments Assignment[] @relation("AssignmentCreatedBy")
  updatedAssignments Assignment[] @relation("AssignmentUpdatedBy")
  gradedHomeworkAssignments HomeworkSubmission[] @relation("HomeworkGradedBy")
  gradedAssignmentAssignments AssignmentSubmission[] @relation("AssignmentGradedBy")

  createdExams  Exam[]      @relation("ExamCreatedBy")
  updatedExams  Exam[]      @relation("ExamUpdatedBy")
  enteredExamMarks ExamMark[] @relation("ExamMarkEnteredBy")
  updatedExamMarks ExamMark[] @relation("ExamMarkUpdatedBy")

  @@index([schoolId])
  @@index([email])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  memberships     TenantMembership[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

// Tenant access granted to a global User. One membership per (user, school)
// with a single role for now. `roleId` drives the user's permissions *within
// that school*; the same user may hold different roles in different schools.
model TenantMembership {
  id        String           @id @default(uuid())
  userId    String
  schoolId  String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Students / academic structure (first real business domain).
//
// Decisions:
//   - `User` stays a pure authentication identity. `Student` is a domain
//     entity that exists independently of any login; it only references Users
//     via nullable createdBy/updatedBy for auditability.
//   - Academic placement lives on `StudentEnrollment` (one row per student per
//     academic session), never on the Student row. This keeps historical
//     placement answerable and makes future promotion a new enrollment rather
//     than a destructive overwrite. One student = one placement per session
//     (@@unique([studentId, academicSessionId])).
//   - `Class` / `Section` are separate master records ("Class 10" + section
//     "A"), never one opaque "Class 10 - A" string.
//   - Guardians are reusable school-scoped people linked to students through
//     `StudentGuardian` (relationship type, primary, emergency flags). A
//     guardian may relate to several students; a student may have several
//     guardians; the service layer enforces at most one primary per student.
//   - `StudentStatus` models the lifecycle explicitly (no destructive DELETE).
//   - `photoUrl` is a URL reference so a file-storage solution can plug in
//     later; raw image blobs are never stored in PostgreSQL.
// ────────────────────────────────────────────────────────────────────────────

model Class {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections              Section[]
  enrollments           StudentEnrollment[]
  teacherClasses        TeacherClass[]
  feeStructures         FeeStructure[]
  admissionApplications AdmissionApplication[] @relation("ApplicationPreferredClass")
  timetableEntries      TimetableEntry[]
  attendanceRecords     AttendanceRecord[]
  homeworks             Homework[]
  assignments           Assignment[]

  exams Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id        String   @id @default(uuid())
  classId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments           StudentEnrollment[]
  teacherClasses        TeacherClass[]
  admissionApplications AdmissionApplication[] @relation("ApplicationPreferredSection")
  timetableEntries      TimetableEntry[]
  attendanceRecords     AttendanceRecord[]
  homeworks             Homework[]
  assignments           Assignment[]

  exams Exam[]

  @@unique([classId, name])
  @@index([classId])
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherSubjects TeacherSubject[]
  timetableEntries TimetableEntry[]
  homeworks        Homework[]
  assignments      Assignment[]

  examSubjects ExamSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Guardian {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  email     String?
  phone     String?
  address   String?
  // Optional link to a login account. A single Guardian person row may be
  // related to many students (via StudentGuardian), so one parent login can
  // cover multiple children within the same school.
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentGuardians StudentGuardian[]
  user             User?             @relation("GuardianUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
}

model StudentGuardian {
  id                 String                   @id @default(uuid())
  studentId          String
  guardianId         String
  relationshipType   GuardianRelationshipType
  isPrimary          Boolean                  @default(false)
  isEmergencyContact Boolean                  @default(false)
  createdAt          DateTime                 @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}

model Student {
  id                    String        @id @default(uuid())
  schoolId              String
  admissionNumber       String
  firstName             String
  middleName            String?
  lastName              String?
  dateOfBirth           DateTime      @db.Date
  gender                StudentGender
  photoUrl              String?
  status                StudentStatus @default(ACTIVE)
  email                 String?
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  admissionDate         DateTime      @db.Date
  emergencyContactName  String?
  emergencyContactPhone String?
  // Optional link to a login account (future student portal).
  userId                String?       @unique
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  school                    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentGuardians          StudentGuardian[]
  enrollments               StudentEnrollment[]
  attendanceRecords         AttendanceRecord[]
  feeInvoices               FeeInvoice[]
  feeReceipts               FeeReceipt[]
  createdByUser             User?                  @relation("StudentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser             User?                  @relation("StudentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  user                      User?                  @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  convertedFromApplications AdmissionApplication[] @relation("ApplicationConvertedStudent")
  homeworkSubmissions       HomeworkSubmission[]
  assignmentSubmissions     AssignmentSubmission[]

  examResults ExamResult[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
}

model StudentEnrollment {
  id                String   @id @default(uuid())
  studentId         String
  academicSessionId String
  classId           String
  sectionId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  homeworkSubmissions   HomeworkSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  feeInvoices           FeeInvoice[]

  examResults ExamResult[]

  @@unique([studentId, academicSessionId])
  @@index([academicSessionId])
  @@index([classId, sectionId])
}

// ────────────────────────────────────────────────────────────────────────────
// Teachers & Staff (second business domain).
//
// Decisions:
//   - Teachers and Staff are separate domain entities (not a shared Employee
//     abstraction) because they have fundamentally different relationships:
//     teachers link to subjects/classes for timetable/homework, while staff
//     are department-based non-teaching employees.
//   - `EmployeeStatus` (ACTIVE/INACTIVE/ON_LEAVE) is shared via a single
//     Prisma enum for both tables.
//   - `StudentGender` is reused for gender on both Teacher and Staff.
//   - Employee IDs are server-generated from per-school atomic counters
//     (TCH-YYYY-NNNN / STF-YYYY-NNNN), matching the Student admission
//     number pattern.
//   - `TeacherSubject` and `TeacherClass` junction tables support future
//     timetable, homework, assignments, and exam module relationships.
//   - No `userId` FK yet — teachers/staff are domain entities independent
//     of login; a future module can add the link when staff login is built.
// ────────────────────────────────────────────────────────────────────────────

model Teacher {
  id            String         @id @default(uuid())
  schoolId      String
  employeeId    String
  firstName     String
  middleName    String?
  lastName      String?
  gender        StudentGender
  dateOfBirth   DateTime?      @db.Date
  email         String?
  phone         String?
  address       String?
  designation   String
  qualification String?
  experience    Int?
  joiningDate   DateTime       @db.Date
  status        EmployeeStatus @default(ACTIVE)
  photoUrl      String?
  // Optional link to a login account (future teacher portal).
  userId        String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  teacherClasses  TeacherClass[]
  timetableEntries TimetableEntry[]
  user            User?            @relation("TeacherUser", fields: [userId], references: [id], onDelete: SetNull)
  homeworks       Homework[]
  assignments     Assignment[]

  examSubjects ExamSubject[]

  @@unique([schoolId, employeeId])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([userId])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  teacherId String
  subjectId String
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([subjectId])
}

model TeacherClass {
  id        String   @id @default(uuid())
  teacherId String
  classId   String
  sectionId String?
  createdAt DateTime @default(now())

  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([teacherId, classId, sectionId])
  @@index([classId, sectionId])
}

model Staff {
  id                           String         @id @default(uuid())
  schoolId                     String
  employeeId                   String
  firstName                    String
  middleName                   String?
  lastName                     String?
  gender                       StudentGender
  dateOfBirth                  DateTime?      @db.Date
  email                        String?
  phone                        String?
  address                      String?
  department                   String
  designation                  String
  qualification                String?
  experience                   Int?
  joiningDate                  DateTime       @db.Date
  status                       EmployeeStatus @default(ACTIVE)
  photoUrl                     String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  // Optional link to a login account (future staff portal).
  userId                       String?        @unique
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([schoolId, employeeId])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// Shared config / master data (Phase 0 schema scaffolding; services land in
// later phases). All of these are tenant-scoped so each school configures its
// own timetable periods, grading bands, fee heads and settings.
// ────────────────────────────────────────────────────────────────────────────

// Tracks the distinct time-of-day slots a school uses across the weekly
// timetable. Periods are per-school master rows referenced by TimetableEntry.
model PeriodSlot {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  startTime String // "HH:MM" (24h)
  endTime   String // "HH:MM" (24h)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A fee head/category of a fee (e.g. tuition, transport, admission).
model FeeHead {
  id          String   @id @default(uuid())
  schoolId    String
  code        String
  name        String
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  FeeStructureItem[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// A named set of fee items configured for a class within an academic session.
// One structure per class per session (enforced by @@unique). Historical
// invoices snapshot structure data at generation time, so edits here never
// mutate existing invoices.
model FeeStructure {
  id          String   @id @default(uuid())
  schoolId    String
  sessionId   String
  classId     String
  name        String
  isActive    Boolean  @default(true)
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  items   FeeStructureItem[]
  invoices     FeeInvoice[]

  @@unique([schoolId, sessionId, classId])
  @@index([schoolId])
}

model FeeStructureItem {
  id             String   @id @default(uuid())
  feeStructureId String
  feeHeadId      String
  amount         Decimal  @db.Decimal(12, 2)
  // Legacy installment columns preserved for migration safety (Phase 7 decision).
  // New payment schedules are modelled by FeeInstallment; these are not read by
  // Phase 7 code and may be deprecated after a data audit.
  installmentNo  Int      @default(1)
  dueDate        DateTime @db.Date
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([feeStructureId, feeHeadId, installmentNo])
  @@index([feeStructureId])
  @@index([feeHeadId])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum InstallmentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

// A recorded FeePayment is always a completed, successful payment: funds are
// known to be received before the payment is written, and the payment is
// created atomically with its FeeReceipt. Reversal/cancellation lifecycles are
// deliberately out of scope for this milestone (a future module can add values).
enum PaymentStatus {
  SUCCESS
}

// One financial obligation per student per academic session. Generated from a
// class FeeStructure; all financial facts that need historical stability are
// snapshotted here (class/section/session names + item amounts JSON) so a
// later change to the student's placement or the fee structure never rewrites
// the past. `balance`/`status` are denormalized for query performance and are
// maintained on every payment write.
model FeeInvoice {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String
  enrollmentId   String
  sessionId      String
  feeStructureId String?
  invoiceNumber  String
  className      String
  sectionName    String?
  sessionName    String
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  balance        Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  items          Json
  notes          String?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  session      AcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  feeStructure FeeStructure?     @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  createdByUser User?            @relation("FeeInvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  installments FeeInstallment[]
  payments     FeePayment[]
  receipts     FeeReceipt[]

  @@unique([schoolId, studentId, sessionId])
  @@index([schoolId, studentId])
  @@index([schoolId, sessionId])
  @@index([schoolId, status])
  @@index([invoiceNumber])
}

// A payment-schedule line within an invoice. Configurable at invoice generation
// time (e.g. term 1/2, or monthly). `balance`/`status` are managed on payment
// writes; an installment whose due date has passed while unpaid/partial is
// treated as OVERDUE.
model FeeInstallment {
  id            String            @id @default(uuid())
  schoolId      String
  invoiceId     String
  installmentNo Int
  label         String
  amount        Decimal           @db.Decimal(12, 2)
  dueDate       DateTime          @db.Date
  amountPaid    Decimal           @default(0) @db.Decimal(12, 2)
  balance       Decimal           @default(0) @db.Decimal(12, 2)
  status        InstallmentStatus @default(UNPAID)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, installmentNo])
  @@index([invoiceId])
  @@index([schoolId, status])
  @@index([schoolId, dueDate])
}

// A single completed payment applied to a fee invoice (one payment may cover
// several installments via FIFO allocation). Payments are recorded only when
// funds are actually received; `idempotencyKey` guards against duplicate
// submissions (unique per school, enforced by the DB). Creating a payment also
// creates its immutable FeeReceipt in the same transaction.
model FeePayment {
  id             String        @id @default(uuid())
  schoolId       String
  invoiceId      String
  paymentNumber  String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  transactionRef String?
  paymentDate    DateTime      @db.Date
  notes          String?
  status         PaymentStatus @default(SUCCESS)
  idempotencyKey String?
  recordedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school         School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice        FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receipt        FeeReceipt?
  recordedByUser User?       @relation("PaymentRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([schoolId, paymentNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentDate])
  @@index([invoiceId])
}

// An immutable receipt issued for every successful fee payment (1:1). All
// displayed financial facts are snapshotted at issuance so a later change to
// the student, their placement, or the invoice data never rewrites history.
// There are intentionally no update/delete operations in the API.
model FeeReceipt {
  id              String        @id @default(uuid())
  schoolId        String
  paymentId       String        @unique
  invoiceId       String
  receiptNumber   String
  studentId       String
  studentName     String
  admissionNumber String
  className       String
  sectionName     String?
  sessionName     String
  sessionYear     Int
  invoiceNumber   String
  invoiceTotal    Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  balanceAfter    Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  paymentDate     DateTime      @db.Date
  transactionRef  String?
  receivedBy      String?
  receivedByName  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school          School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment         FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice         FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  receivedByUser  User?      @relation("ReceiptIssuedBy", fields: [receivedBy], references: [id], onDelete: SetNull)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentDate])
  @@index([schoolId, createdAt])
}

// Exam types (e.g. midterm, final) — tenant-scoped.
model ExamType {
  id        String   @id @default(uuid())
  schoolId  String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exams Exam[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// Configurable percentage → letter grade bands used for Results. Tenant-scoped.
model GradingBand {
  id          String   @id @default(uuid())
  schoolId    String
  minPercent  Int // inclusive lower bound
  maxPercent  Int // inclusive upper bound
  grade       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, minPercent])
  @@index([schoolId])
}

// Generic key/value store for tenant-scoped school configuration.
model SchoolSetting {
  id        String   @id @default(uuid())
  schoolId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId])
}

// ────────────────────────────────────────────────────────────────────────────
// Notices & Events (Phase 2 communication module).
//
// Decisions:
//   - Both are tenant-scoped (schoolId FK), isolated per school.
//   - `Notice` carries an explicit status lifecycle (DRAFT → PUBLISHED →
//     ARCHIVED) plus an audience so a school can target students, parents,
//     teachers or staff without leaking to other tenants. `publishedAt` is set
//     server-side the moment a notice transitions to PUBLISHED.
//   - `Event` holds a start/end window, a category and a status. Dates are
//     stored as DateTime (with time) so 24h timelines and ordering are exact.
//   - `createdBy`/`updatedBy` link back to the acting User for auditability and
//     notice/event authorship (owner checks in the service layer).
// ────────────────────────────────────────────────────────────────────────────

enum NoticeAudience {
  EVERYONE
  STUDENTS
  PARENTS
  TEACHERS
  STAFF
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoticePriority {
  HIGH
  MEDIUM
  LOW
}

model Notice {
  id          String         @id @default(uuid())
  schoolId    String
  title       String
  body        String
  audience    NoticeAudience @default(EVERYONE)
  status      NoticeStatus   @default(DRAFT)
  priority    NoticePriority @default(MEDIUM)
  publishedAt DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("NoticeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?  @relation("NoticeUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, createdAt])
}

enum EventCategory {
  GENERAL
  ACADEMIC
  SPORTS
  CULTURAL
  COMMUNITY
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id          String        @id @default(uuid())
  schoolId    String
  title       String
  description String?
  category    EventCategory @default(GENERAL)
  status      EventStatus   @default(SCHEDULED)
  startAt     DateTime
  endAt       DateTime
  location    String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("EventCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?  @relation("EventUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([schoolId, startAt])
  @@index([schoolId, status])
}

// ────────────────────────────────────────────────────────────────────────────
// Admissions (Phase 3 — applicant intake pipeline).
//
// Decisions:
//   - `AdmissionApplication` captures a prospective student BEFORE they become
//     a `Student`. It is tenant-scoped (schoolId FK) like every other domain
//     entity; the school is always resolved server-side from the session.
//   - The applicant's identity/contact fields mirror the Student model so the
//     intake can be converted to a Student without guessing a mapping.
//   - A single inline primary guardian (name + optional contact + relationship)
//     is captured at intake; a full multi-guardian model is the Students module's
//     concern and is resolved at conversion time.
//   - Placement is a *preference* (`preferredAcademicSession`, `preferredClass`,
//     `preferredSection`) that the school may record but is not required to
//     enter up front; the ACTIVE session + class/section are resolved authoritatively
//     at conversion time by the service layer.
//   - Status workflow: PENDING → APPROVED / REJECTED / WITHDRAWN. Approval stamps
//     `reviewedAt`/`reviewedBy`/`reviewNote` server-side. A dedicated
//     convert-to-Student action stamps `convertedAt`/`convertedBy` and links the
//     resulting `Student` through `convertedStudentId`, then flips status to a
//     terminal `CONVERTED` so the pipeline is unambiguous and idempotent.
//   - Application numbers are server-generated (`APP-YYYY-NNNN`) from the
//     per-school atomic `School.admissionApplicationCounter`, matching the
//     admission-number/employee-id pattern. Uniqueness is enforced by
//     `@@unique([schoolId, applicationNumber])`.
// ────────────────────────────────────────────────────────────────────────────

enum AdmissionApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CONVERTED
}

model AdmissionApplication {
  id                         String                     @id @default(uuid())
  schoolId                   String
  applicationNumber          String
  firstName                  String
  middleName                 String?
  lastName                   String?
  dateOfBirth                DateTime                   @db.Date
  gender                     StudentGender
  email                      String?
  phone                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  state                      String?
  postalCode                 String?
  status                     AdmissionApplicationStatus @default(PENDING)
  // Preferred placement (optional at intake; resolved authoritatively at conversion).
  preferredAcademicSessionId String?
  preferredClassId           String?
  preferredSectionId         String?
  // Inline primary guardian captured at intake.
  guardianName               String
  guardianPhone              String?
  guardianEmail              String?
  guardianRelationshipType   GuardianRelationshipType   @default(PARENT)
  // Intake review bookkeeping.
  reviewNote                 String?
  reviewedBy                 String?
  reviewedAt                 DateTime?
  // Convert-to-Student bookkeeping.
  convertedStudentId         String?
  convertedBy                String?
  convertedAt                DateTime?
  createdBy                  String?
  updatedBy                  String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  school                   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  preferredAcademicSession AcademicSession? @relation("ApplicationPreferredSession", fields: [preferredAcademicSessionId], references: [id], onDelete: SetNull)
  preferredClass           Class?           @relation("ApplicationPreferredClass", fields: [preferredClassId], references: [id], onDelete: SetNull)
  preferredSection         Section?         @relation("ApplicationPreferredSection", fields: [preferredSectionId], references: [id], onDelete: SetNull)
  convertedStudent         Student?         @relation("ApplicationConvertedStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  createdByUser            User?            @relation("ApplicationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser            User?            @relation("ApplicationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  reviewedByUser           User?            @relation("ApplicationReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  convertedByUser          User?            @relation("ApplicationConvertedBy", fields: [convertedBy], references: [id], onDelete: SetNull)

  @@unique([schoolId, applicationNumber])
  @@index([schoolId, status])
  @@index([schoolId, createdAt])
  @@index([schoolId, lastName])
  @@index([convertedStudentId])
}

// ────────────────────────────────────────────────────────────────────────────
// Timetable & Attendance (Phase 4).
//
// Decisions:
//   - `TimetableEntry` defines one recurring weekly slot: a class/section
//     takes a subject from a teacher during a PeriodSlot on a specific day.
//     Conflict prevention is handled by two @@unique constraints — same
//     class+section OR same teacher cannot overlap at the same period+day.
//   - `AttendanceRecord` is a daily per-student snapshot. `classId`/`sectionId`
//     are denormalized from the enrollment at mark-time so historical records
//     survive mid-session class transfers. `markedBy` is set server-side.
//   - Both models are tenant-scoped (schoolId FK). Foreign IDs are validated
//     server-side to belong to the same school.
// ────────────────────────────────────────────────────────────────────────────

model TimetableEntry {
  id                String       @id @default(uuid())
  schoolId          String
  academicSessionId String
  dayOfWeek         TimetableDay
  periodSlotId      String
  classId           String
  sectionId         String?
  subjectId         String
  teacherId         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  periodSlot      PeriodSlot      @relation(fields: [periodSlotId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Prevent same class/section from being double-booked at the same period+day.
  @@unique([schoolId, academicSessionId, dayOfWeek, periodSlotId, classId, sectionId], map: "timetable_class_slot_unique")
  // Prevent same teacher from being double-booked at the same period+day.
  @@unique([schoolId, academicSessionId, dayOfWeek, periodSlotId, teacherId], map: "timetable_teacher_slot_unique")
  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, teacherId])
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  schoolId          String
  academicSessionId String
  classId           String
  sectionId         String?
  date              DateTime         @db.Date
  studentId         String
  enrollmentId      String
  status            AttendanceStatus @default(PRESENT)
  note              String?
  markedBy          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment      StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  markedByUser    User?           @relation("AttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  // One record per student per day per school.
  @@unique([schoolId, enrollmentId, date])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, studentId])
  @@index([schoolId, date])
}

// ────────────────────────────────────────────────────────────────────────────
// Homework & Assignments (Phase 5).
//
// Decisions:
//   - Homework and Assignments are two clearly separate entities (matching the
//     separate permission resources, nav items and module placeholders). They
//     share one `TaskStatus` enum and the same targeting shape; the FK
//     validation for the targeting references and the lifecycle transitions
//     are shared helpers, so the tables do not duplicate logic.
//   - Targeting is cohort-based: academic session + class (+ optional section)
//     + subject + teacher. The recipients are derived from `StudentEnrollment`
//     filtered by (academicSessionId, classId, sectionId); a sectionless class
//     is never forced to have a section.
//   - `status` lifecycle is minimal (DRAFT → PUBLISHED → ARCHIVED); there is no
//     stored CLOSED state — "overdue" is derived from `dueDate < today` so the
//     UI can never drift from the real due date. `publishedAt` is set
//     server-side on the DRAFT→PUBLISHED transition (matches Notice).
//   - `dueDate` is a `@db.Date` (date-only). The API boundary is the bare
//     `YYYY-MM-DD` string, so there is no timezone conversion and no
//     UTC-boundary bug. Time-of-day due dates are deferred deliberately.
//   - Submissions are schema-ready now (no endpoints/UI this phase) so the
//     future student/parent portal requires no redesign. Each submission links
//     to the submitting student's `StudentEnrollment` snapshot (same as
//     AttendanceRecord) so mid-session transfers never rewrite history.
//     `@@unique([*, enrollmentId])` enforces one submission per student/task;
//     resubmission is a controlled UPDATE. `attachmentUrl` mirrors `photoUrl`
//     — file storage itself is deferred.
//   - Teacher ownership: a TEACHER-role user may only manage homework for their
//     own Teacher profile (`Teacher.userId`), and the target class/section and
//     subject must be covered by that teacher's `TeacherClass`/`TeacherSubject`
//     rows. Admins (SUPER_ADMIN/SCHOOL_ADMIN/PRINCIPAL-create) may create for
//     any in-school teacher; all targets remain school-scoped.
// ────────────────────────────────────────────────────────────────────────────

model Homework {
  id                String      @id @default(uuid())
  schoolId          String
  academicSessionId String
  classId           String
  sectionId         String?
  subjectId         String
  teacherId         String
  title             String
  instructions      String?
  dueDate           DateTime    @db.Date
  status            TaskStatus  @default(DRAFT)
  publishedAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdByUser   User?           @relation("HomeworkCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser   User?           @relation("HomeworkUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  submissions HomeworkSubmission[]

  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, subjectId])
  @@index([schoolId, teacherId])
  @@index([schoolId, status, dueDate])
}

model Assignment {
  id                String      @id @default(uuid())
  schoolId          String
  academicSessionId String
  classId           String
  sectionId         String?
  subjectId         String
  teacherId         String
  title             String
  instructions      String?
  dueDate           DateTime    @db.Date
  status            TaskStatus  @default(DRAFT)
  publishedAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdByUser   User?           @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser   User?           @relation("AssignmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  submissions AssignmentSubmission[]

  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, subjectId])
  @@index([schoolId, teacherId])
  @@index([schoolId, status, dueDate])
}

model HomeworkSubmission {
  id            String             @id @default(uuid())
  schoolId      String
  homeworkId    String
  studentId     String
  enrollmentId  String
  content       String?
  attachmentUrl String?
  status        TaskSubmissionStatus @default(SUBMITTED)
  marks         Decimal?            @db.Decimal(7, 2)
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  submittedAt   DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework     Homework          @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  gradedByUser User?             @relation("HomeworkGradedBy", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([homeworkId, enrollmentId])
  @@index([schoolId, homeworkId])
  @@index([schoolId, studentId])
}

model AssignmentSubmission {
  id            String             @id @default(uuid())
  schoolId      String
  assignmentId  String
  studentId     String
  enrollmentId  String
  content       String?
  attachmentUrl String?
  status        TaskSubmissionStatus @default(SUBMITTED)
  marks         Decimal?            @db.Decimal(7, 2)
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  submittedAt   DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  gradedByUser User?             @relation("AssignmentGradedBy", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@unique([assignmentId, enrollmentId])
  @@index([schoolId, assignmentId])
  @@index([schoolId, studentId])
}

// ────────────────────────────────────────────────────────────────────────────
// Exams & Results (Phase 6).
//
// Decisions:
//   - Exams are class-scoped definitions: one `Exam` row per class (+ optional
//     section). A "school-wide" exam (e.g. Term 1) is represented as one Exam
//     row per participating class sharing `examTypeId`/`name`/session, grouped
//     for reporting by (academicSessionId, examTypeId). Per-class `ExamSubject`
//     lists mean the subject set is naturally class-specific, and marks entry /
//     ranking / report cards are per-class operations.
//   - `ExamSubject.maxMarks`/`passMarks` are per-subject; `examTypeId` reuses
//     the existing tenant-scoped ExamType master; letters come from the existing
//     GradingBand table. Neither config table changes in this phase.
//   - `ExamResult` is the per-(exam, enrollment) aggregate and pins the
//     `enrollmentId` snapshot (AttendanceRecord/HomeworkSubmission precedent):
//     a student's later class/section/enrollment change never rewrites history.
//     `rank` is server-computed and cached at finalize (PUBLISHED → FINAL).
//   - `ExamMark` holds per-subject marks; every derived value (percentage,
//     grade, isPass) is server-computed. Absent = no marks, excluded from
//     totals and rank (never recorded as zero).
//   - Lifecycle: DRAFT (config) → PUBLISHED (marks entry) → FINAL (frozen;
//     aggregates/rank computed) → ARCHIVED (history). Correction path is
//     reopen (FINAL → PUBLISHED) then re-finalize; timestamps are server-set.
//   - Teacher ownership mirrors Tasks: a TEACHER actor manages/enters only
//     exams/subjects covered by their TeacherSubject/TeacherClass rows, and
//     marks entry is limited to the responsible teacher listed on ExamSubject.
// ────────────────────────────────────────────────────────────────────────────

model Exam {
  id                String     @id @default(uuid())
  schoolId          String
  academicSessionId String
  examTypeId        String
  name              String
  classId           String
  sectionId         String?
  startDate         DateTime   @db.Date
  endDate           DateTime   @db.Date
  status            ExamStatus @default(DRAFT)
  publishedAt       DateTime?
  finalizedAt       DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  examType        ExamType        @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdByUser   User?           @relation("ExamCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser   User?           @relation("ExamUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  subjects ExamSubject[]
  results  ExamResult[]

  @@unique([schoolId, academicSessionId, examTypeId, classId, sectionId], map: "exam_same_instance_unique")
  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, status])
}

model ExamSubject {
  id        String   @id @default(uuid())
  examId    String
  subjectId String
  teacherId String
  maxMarks  Decimal  @db.Decimal(7, 2)
  passMarks Decimal  @db.Decimal(7, 2)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  marks ExamMark[]

  @@unique([examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([teacherId])
}

model ExamResult {
  id             String    @id @default(uuid())
  schoolId       String
  examId         String
  studentId      String
  enrollmentId   String
  totalObtained  Decimal?  @db.Decimal(7, 2)
  totalMaxMarks  Decimal?  @db.Decimal(7, 2)
  totalPercentage Decimal? @db.Decimal(5, 2)
  grade          String?
  isPass         Boolean?
  rank           Int?
  isComplete     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam       Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  marks ExamMark[]

  @@unique([examId, enrollmentId])
  @@index([schoolId, examId])
  @@index([schoolId, studentId])
  @@index([examId, rank])
}

model ExamMark {
  id            String    @id @default(uuid())
  schoolId      String
  examResultId  String
  examSubjectId String
  obtainedMarks Decimal?  @db.Decimal(7, 2)
  isAbsent      Boolean   @default(false)
  percentage    Decimal?  @db.Decimal(5, 2)
  grade         String?
  isPass        Boolean?
  remarks       String?
  enteredBy     String?
  enteredAt     DateTime?
  updatedBy     String?
  updatedAt     DateTime  @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examResult ExamResult  @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enteredByUser User?    @relation("ExamMarkEnteredBy", fields: [enteredBy], references: [id], onDelete: SetNull)
  updatedByUser User?    @relation("ExamMarkUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([examResultId, examSubjectId])
  @@index([schoolId, examSubjectId])
  @@index([schoolId, examResultId])
}
