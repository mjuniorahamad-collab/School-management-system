# ──────────────────────────────────────────────────────────────────────────
# School Management System — environment template
#
# Copy this file to `.env` for local development. `.env` is never committed.
# The single root `.env` serves both sides: Vite reads `VITE_*` automatically
# and the API server loads the file via `process.loadEnvFile()`.
#
# Lines below are OPTIONAL unless marked REQUIRED. Values shown are defaults.
# ──────────────────────────────────────────────────────────────────────────

# ── Backend (server/) ─────────────────────────────────────────────────────

# Runtime environment: development | test | production (default: development)
# NODE_ENV=development

# API server port (default: 4000)
# PORT=4000

# Browser origins allowed to call the API directly (comma-separated).
# Default: http://localhost:5173, http://localhost:4173 (Vite dev/preview).
# In development the Vite proxy makes requests same-origin, so CORS only
# matters when hitting the API cross-origin. Never use "*".
# CORS_ORIGIN=http://localhost:5173

# REQUIRED once DB-backed features are enabled (auth/RBAC now needs it).
# The server boots without it; authenticated endpoints fail cleanly until set.
# Local database options (pick ONE):
#   • Docker:   docker compose up -d            (see docker-compose.yml)
#   • User-space PG: npm run db:local:start     (see README, no admin needed)
DATABASE_URL="postgresql://school:school@localhost:5432/school_management"

# Session cookie lifetimes.
# SESSION_ACCESS_TTL_MINUTES=15
# SESSION_REFRESH_TTL_DAYS=7

# Rate limiting for public auth endpoints (brute-force / CPU-abuse defence).
# AUTH_RATE_LIMIT_MAX=20            # max attempts per client per window
# AUTH_RATE_LIMIT_WINDOW_MINUTES=10 # window length

# Set to true ONLY when the API runs behind a reverse proxy that forwards the
# real client IP (X-Forwarded-For) to the API. This makes rate limiting and
# request logging see the caller instead of the proxy. Keep off in dev/test.
# TRUST_PROXY=true

# ── Profile photos (object storage) ────────────────────────────────────────
#
# Photos are stored OUTSIDE PostgreSQL: the DB keeps only a server-generated
# object key in each entity's `photoUrl` column. Reads are always authenticated
# and tenant-scoped (the object itself is never exposed via a public URL).
#
# Local (default): writes to the persistent `server/uploads` directory.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=uploads
#
# Pass storage placeholder→S3 in production. STORAGE_PROVIDER=s3 also requires
# the five S3_* values below and targets an S3-compatible bucket (e.g. Cloudflare
# R2). Buckets MUST stay private; serving happens server-side.
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=sms-photos
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_FORCE_PATH_STYLE=true   # required for R2/localstack-style endpoints
#
# Upload limits.
# UPLOAD_MAX_SIZE_MB=5                # max accepted photo file size
# UPLOAD_RATE_LIMIT_MAX=10            # uploads per client per window
# UPLOAD_RATE_LIMIT_WINDOW_MINUTES=1  # window length

# Dev super admin created by `npm run db:seed`. REQUIRED (non-production only)
# to seed the initial administrator; the password is hashed with scrypt, is
# never printed, and is never overwritten on re-seeding. Use a strong value.
# SEED_ADMIN_EMAIL=admin@brightfuture.edu
# SEED_ADMIN_PASSWORD=changeme-strong-password

# OPTIONAL. When set, `npm test` also runs the DB-backed vitest integration
# suites (they apply migrations to this database and clean up after themselves).
# Leave unset to run only the DB-free unit tests.
# TEST_DATABASE_URL="postgresql://school@127.0.0.1:5433/school_management_test"

# ── Frontend (Vite) ───────────────────────────────────────────────────────

# Base URL of the REST API (default: /api/v1 — proxied in dev, relative in prod).
# Set to the full API origin when serving the frontend and API on different
# hosts: VITE_API_URL=http://localhost:4000/api/v1
# VITE_API_URL=/api/v1